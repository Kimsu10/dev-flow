POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SERVER_PORT=8080
# Discord 보고 전용. 실제 URL은 추적하지 않는 .env에만 설정하세요.
DISCORD_WEBHOOK_URL=

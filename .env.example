POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
SERVER_PORT=8080
# Discord 보고 전용. 실제 URL은 추적하지 않는 .env에만 설정하세요.
DISCORD_WEBHOOK_URL=
# Agent는 PostgreSQL의 호스트 포트를 사용합니다 (현재 로컬 설정: 15432).
# POSTGRES_HOST=localhost
# CODEX_EXECUTABLE=C:/path/to/@openai/codex/bin/codex.js

# S3 images (Seoul). Credentials are resolved from the local AWS profile.
AWS_REGION=ap-northeast-2
AWS_PROFILE=devflow-dev
S3_BUCKET_NAME=

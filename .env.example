POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
SERVER_PORT=8080
# Discord 보고 전용. 실제 URL은 추적하지 않는 .env에만 설정하세요.
DISCORD_WEBHOOK_URL=
# Agent는 PostgreSQL의 호스트 포트를 사용합니다 (현재 로컬 설정: 15432).
# POSTGRES_HOST=localhost
# CODEX_EXECUTABLE=C:/path/to/@openai/codex/bin/codex.js

# S3 images (Seoul). Credentials are resolved from the local AWS profile.
AWS_REGION=ap-northeast-2
AWS_PROFILE=devflow-dev
S3_BUCKET_NAME=

# Set false ONLY for local HTTP development; HTTPS deployments must use true.
SESSION_COOKIE_SECURE=false
# Optional one-time bootstrap; remove password from environment after first creation.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
# Set NATIVE only behind a trusted reverse proxy which sanitizes forwarded headers.
FORWARD_HEADERS_STRATEGY=NONE

# Analytics stores no raw IP/User-Agent. 90 to 3650 days.
ANALYTICS_RETENTION_DAYS=365
# Optional exact public origin behind a reverse proxy, e.g. https://blog.example.com
ANALYTICS_PUBLIC_ORIGIN=

# Optional AI research drafts (server only; never use VITE_ for credentials).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Trial accounts use a server-selected low-cost model, never a browser-supplied model.
TEST_USER_OPENAI_MODEL=gpt-6-luna
TEST_USER_MAX_OUTPUT_TOKENS=2000
TEST_USER_DAILY_AI_REQUESTS=50
